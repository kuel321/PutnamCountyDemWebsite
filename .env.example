# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Gmail SMTP, used to send password-reset emails
# GMAIL_APP_PASSWORD is a Gmail "App Password", not your regular account password
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=YOUR_APP_PASSWORD_HERE

# Google reCAPTCHA v2 (checkbox), used to spam-protect the Form block.
# Both must be set together — leave both unset and it's a harmless no-op
# placeholder (forms submit normally, just without bot protection).
# Get keys at https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
